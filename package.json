{
  "name": "motif",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "inline:sources": "bun run scripts/inline-sources.ts",
    "build": "bun run inline:sources && astro build",
    "preview": "astro preview",
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint": "oxlint --deny-warnings src",
    "check:registry": "bun run scripts/check-registry.ts",
    "check:versions": "bun run scripts/check-versions.ts",
    "test": "bun test",
    "test:smoke": "bun run test/smoke.ts",
    "format": "oxfmt --write \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint:biome": "biome lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@vectojs/core": "1.24.0",
    "@vectojs/three": "0.1.8",
    "@vectojs/ui": "2.5.0",
    "astro": "^7.0.3",
    "codemirror": "^6.0.2",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/bun": "^1.3.14",
    "oxlint": "^1.76.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "carryctx": "0.4.4",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.61.0"
  }
}
