---
const version = "1.9.2";
---

<header class="topbar">
  <label
    for="nav-toggle"
    class="nav-toggle-btn"
    role="button"
    aria-label="Toggle navigation"
    tabindex="0"><span aria-hidden="true">☰</span></label
  >
  <a class="brand" href="/" aria-label="Motif home">
    <span class="brand-mark">M</span>
    <span>
      <span class="brand-name">Motif</span>
      <span class="brand-sub">· VectoJS gallery</span>
    </span>
  </a>
  <button
    class="top-search"
    type="button"
    aria-label="Search components and effects"
    data-search-trigger
  >
    <span aria-hidden="true">⌕</span> Search components &amp; effects…
    <kbd>⌘K</kbd>
  </button>
  <div class="top-actions">
    <span class="top-pill gpu" data-gpu-pill>● WebGPU</span>
    <span class="top-pill">core {version}</span>
    <a
      class="top-pill"
      href="https://github.com/vectojs"
      target="_blank"
      rel="noopener noreferrer">GitHub ↗</a
    >
  </div>
</header>
