---
const version = "1.9.2";
---

<header class="topbar">
  <label
    for="nav-toggle"
    class="nav-toggle-btn"
    role="button"
    aria-label="Toggle navigation"
    tabindex="0"
    ><svg
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"
      ></path></svg
    ></label
  >
  <a class="brand" href="/" aria-label="Motif home">
    <span class="brand-mark"
      ><svg
        width="30"
        height="30"
        viewBox="0 0 32 32"
        fill="none"
        stroke="#fff"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><g
          ><path d="M 22 5 L 12 15"></path><path d="M 9 11 L 23 11"></path><path
            d="M 16 11 L 16 19 L 7 28"></path><path d="M 5 19 L 27 19"
          ></path><path d="M 16 19 L 25 28"></path><circle
            cx="22"
            cy="5"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="12"
            cy="15"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="9"
            cy="11"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="23"
            cy="11"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="16"
            cy="11"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="16"
            cy="19"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="5"
            cy="19"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="27"
            cy="19"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="7"
            cy="28"
            r="1.5"
            fill="#fff"
            stroke="none"></circle><circle
            cx="25"
            cy="28"
            r="1.5"
            fill="#fff"
            stroke="none"></circle></g
        ></svg
      ></span
    >
    <span>
      <span class="brand-name">Motif</span>
      <span class="brand-sub">· VectoJS gallery</span>
    </span>
  </a>
  <button
    class="top-search"
    type="button"
    aria-label="Search components and effects"
    data-search-trigger
  >
    <svg
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"
      ></circle></svg
    > Search components &amp; effects…
    <kbd>⌘K</kbd>
  </button>
  <div class="top-actions">
    <span class="top-pill gpu" data-gpu-pill
      ><span class="dot"></span> WebGPU</span
    >
    <span class="top-pill">core {version}</span>
    <a
      class="top-pill"
      href="https://github.com/vectojs"
      target="_blank"
      rel="noopener noreferrer"
      >GitHub <svg
        class="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
      ></a
    >
  </div>
</header>
