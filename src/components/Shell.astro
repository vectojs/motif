---
import type { Demo } from "../registry";
import TopBar from "./TopBar.astro";
import LeftNav from "./LeftNav.astro";
import CenterStage from "./CenterStage.astro";
import CodePanel from "./CodePanel.astro";

interface Props {
  demo: Demo;
}
const { demo } = Astro.props;
---

<div class="shell">
  <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
  <TopBar />
  <LeftNav activeId={demo.id} />
  <label for="nav-toggle" class="nav-scrim" aria-label="Close navigation"
  ></label>
  <CenterStage demo={demo} />
  <CodePanel demo={demo} />
</div>
