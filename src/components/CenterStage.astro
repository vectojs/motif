---
import type { Demo } from "../registry";

interface Props {
  demo: Demo;
}
const { demo } = Astro.props;
---

<main class="center-stage" aria-label="Demo preview">
  <div class="stage-head">
    <h1 class="stage-title">{demo.title}</h1>
    <p class="stage-desc">{demo.description}</p>
  </div>

  {
    /*
    The demo runs in a sandboxed iframe pointed at its static route
    `/demos/<id>/` (the authored files mirrored into public/ by inline-sources).
    A real document URL is required so the demo's `./demo.js` and
    `/no-ff-webgpu.js` script refs resolve — a `srcdoc` frame is base
    `about:srcdoc` and cannot load them. `allow-same-origin` is REQUIRED too:
    without it the frame gets an opaque origin, under which ES-module scripts +
    importmaps refuse to execute (module fetch runs in CORS mode and a plain
    static route sends no CORS headers), so the demo never boots. Same-origin
    framing is acceptable here because the parent is a secretless static gallery
    and demos are PR-reviewed first-party code; when v2 adds user-editable code
    it must move to a separate origin for real isolation. Served files ARE the
    code-panel files, so shown == run.
  */
  }
  <div class="viewport" data-viewport data-demo-id={demo.id}>
    <iframe
      class="demo-frame"
      data-demo-frame
      title={`${demo.title} live demo`}
      sandbox="allow-scripts allow-same-origin"
      loading="eager"
      src={`/demos/${demo.id}/index.html`}></iframe>
    <div class="viewport-status" data-status hidden>
      <div class="vs-spinner" data-status-spinner aria-hidden="true"></div>
      <p class="vs-msg" data-status-msg role="status"></p>
      <button class="vs-retry" data-status-retry hidden>Retry</button>
    </div>
    <div class="viewport-note" data-cpu-note hidden>
      Running on CPU fallback
    </div>
  </div>

  <div class="viewport-toolbar" role="group" aria-label="Preview width">
    <button class="vp active" data-vp="fluid">Responsive</button>
    <button class="vp" data-vp="360">360</button>
    <button class="vp" data-vp="768">768</button>
    <button class="vp" data-vp="1280">1280</button>
    <button
      class="vp"
      type="button"
      aria-label="Toggle fullscreen preview"
      data-toggle-fullscreen
      ><svg
        class="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M8 3H5a2 2 0 0 0-2 2v3"></path><path
          d="M16 3h3a2 2 0 0 1 2 2v3"></path><path d="M8 21H5a2 2 0 0 1-2-2v-3"
        ></path><path d="M16 21h3a2 2 0 0 0 2-2v-3"></path></svg
      ></button
    >
    <button class="vp vp-run" data-run
      ><svg
        class="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path
          d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
        ></path></svg
      > Run</button
    >
  </div>

  <button
    class="panel-toggle-btn stage-exit-fullscreen"
    type="button"
    aria-label="Exit fullscreen preview"
    data-toggle-fullscreen
    ><svg
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><path d="M9 3v4a2 2 0 0 1-2 2H3"></path><path
        d="M21 8h-4a2 2 0 0 1-2-2V3"></path><path d="M3 16h4a2 2 0 0 1 2 2v4"
      ></path><path d="M16 21v-4a2 2 0 0 1 2-2h4"></path></svg
    ></button
  >
</main>

<script>
  const viewport = document.querySelector<HTMLElement>("[data-viewport]");
  const initial =
    document.querySelector<HTMLIFrameElement>("[data-demo-frame]");
  const status = document.querySelector<HTMLElement>("[data-status]");
  const statusMsg = document.querySelector<HTMLElement>("[data-status-msg]");
  const statusSpinner = document.querySelector<HTMLElement>(
    "[data-status-spinner]",
  );
  const statusRetry = document.querySelector<HTMLButtonElement>(
    "[data-status-retry]",
  );

  if (viewport && initial && status && statusMsg && statusSpinner) {
    const src = initial.getAttribute("src") ?? "";
    const title = initial.title;
    let currentWidth = "100%";

    function showStatus(msg: string, spinning: boolean, retry: boolean) {
      statusMsg!.textContent = msg;
      statusSpinner!.hidden = !spinning;
      if (statusRetry) statusRetry.hidden = !retry;
      status!.hidden = false;
    }
    function hideStatus() {
      status!.hidden = true;
    }

    function wire(frame: HTMLIFrameElement) {
      showStatus("Loading packages from esm.sh…", true, false);
      // A demo is "booted" once its module ran and sized the canvas backing
      // store (scene.resize / renderer.setSize). An authored <canvas> starts
      // 0×0, so canvas.width > 0 is a demo-type-agnostic ready signal — it
      // fires for Canvas2D, the WebGL point layer, and Three.js alike (a
      // canvas-count check would miss single-canvas and offscreen-texture
      // demos). If it never arrives, the esm.sh fetch is presumed unreachable.
      let settled = false;
      const settle = (fn: () => void) => {
        if (settled) return;
        settled = true;
        fn();
      };
      const timeout = window.setTimeout(() => {
        settle(() =>
          showStatus("Failed to load packages from esm.sh.", false, true),
        );
      }, 12000);

      frame.addEventListener("load", () => {
        const win = frame.contentWindow;
        if (!win) return;
        // Same-origin frame: relay the demo's uncaught errors to an error panel
        // instead of leaving a blank canvas.
        win.addEventListener("error", (e) =>
          settle(() => {
            window.clearTimeout(timeout);
            showStatus(`Demo error: ${e.message}`, false, true);
          }),
        );
        win.addEventListener("unhandledrejection", () =>
          settle(() => {
            window.clearTimeout(timeout);
            showStatus(
              "Demo failed to start (module load error).",
              false,
              true,
            );
          }),
        );
        const check = window.setInterval(() => {
          const canvas = win.document.querySelector("canvas");
          if (canvas && canvas.width > 0) {
            window.clearInterval(check);
            settle(() => {
              window.clearTimeout(timeout);
              hideStatus();
            });
          }
        }, 200);
        window.setTimeout(() => window.clearInterval(check), 12000);
      });
    }

    function mount() {
      viewport!.querySelector("[data-demo-frame]")?.remove();
      const next = document.createElement("iframe");
      next.className = "demo-frame";
      next.dataset.demoFrame = "";
      next.title = title;
      next.setAttribute("sandbox", "allow-scripts allow-same-origin");
      next.setAttribute("loading", "eager");
      next.style.width = currentWidth;
      next.setAttribute("src", src);
      viewport!.appendChild(next);
      wire(next);
    }

    wire(initial);
    statusRetry?.addEventListener("click", mount);
    document
      .querySelector<HTMLButtonElement>("[data-run]")
      ?.addEventListener("click", mount);

    const widths: Record<string, string> = {
      fluid: "100%",
      "360": "360px",
      "768": "768px",
      "1280": "1280px",
    };
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      "[data-vp]",
    )) {
      button.addEventListener("click", () => {
        for (const b of document.querySelectorAll("[data-vp]"))
          b.classList.remove("active");
        button.classList.add("active");
        currentWidth = widths[button.dataset.vp ?? "fluid"];
        const live =
          viewport!.querySelector<HTMLIFrameElement>("[data-demo-frame]");
        if (live) live.style.width = currentWidth;
      });
    }

    // WebGPU-absent (incl. the Firefox shim) means the particle sim runs on the
    // CPU backend — surface it so a viewer knows the demo isn't GPU-accelerated.
    const cpuNote = document.querySelector<HTMLElement>("[data-cpu-note]");
    if (cpuNote && !("gpu" in navigator)) cpuNote.hidden = false;
  }
</script>
