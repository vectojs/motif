---
import type { Demo } from "../registry";

interface Props {
  demo: Demo;
}
const { demo } = Astro.props;
---

<section class="code-panel" aria-label="Demo source">
  <div class="code-head">
    <div class="code-tabs" role="tablist" aria-label="Source files">
      <button
        class="code-tab active"
        role="tab"
        aria-selected="true"
        data-code-tab="module">demo.js</button
      >
      <button
        class="code-tab"
        role="tab"
        aria-selected="false"
        data-code-tab="html">index.html</button
      >
    </div>
    <button class="code-copy" type="button" data-copy>Copy</button>
    <button class="code-run" type="button" data-run
      ><svg
        class="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path
          d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
        ></path></svg
      > Run</button
    >
  </div>

  <div class="code-body">
    <pre
      class="code-source active"
      data-code-source="module"><code>{demo.moduleSource}</code></pre>
    <pre
      class="code-source"
      data-code-source="html"><code>{demo.htmlSource}</code></pre>
  </div>

  <div class="code-foot">
    <span class="ok"><span class="dot"></span> live</span>
    <span>esm.sh</span>
    <span>{demo.packages.join(" · ")}</span>
    <span class="code-license">MIT — copy freely</span>
  </div>
</section>

<script>
  import "./CodeView";
</script>
