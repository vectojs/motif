---
import Layout from "../layouts/Layout.astro";
import Shell from "../components/Shell.astro";
import { DEMOS } from "../registry";

// The landing page features the first registered demo; per-demo routes
// (/{category}/{id}) are generated in Task 7.
const demo = DEMOS[0];
---

<Layout title={`Motif — ${demo.title}`}>
  <Shell demo={demo} />
</Layout>
